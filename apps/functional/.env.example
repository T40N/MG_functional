JWT_SECRET=zmien-mnie-na-dowolny-losowy-ciag

# Database configuration
# DB_HOST/DB_PORT to adres WEWNATRZ sieci compose. Uruchamiajac aplikacje
# lokalnie (npm run dev:functional), nadpisz je: DB_HOST=localhost DB_PORT=55432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# Application configuration
# Port wewnatrz kontenera; na hoscie aplikacja jest pod 3100 (patrz docker-compose.yml)
PORT=3000
