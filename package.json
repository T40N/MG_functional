{
  "name": "mg-thesis",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:functional": "npm run dev -w apps/functional",
    "dev:oop": "npm run dev -w apps/oop",
    "test": "npm run test --workspaces --if-present",
    "test:functional": "npm run test -w apps/functional",
    "test:oop": "npm run test -w apps/oop",
    "build:functional": "npm run build -w apps/functional",
    "build:oop": "npm run build -w apps/oop",
    "lint": "npm run lint --workspaces --if-present",
    "bench:reset": "ts-node -P benchmarks/tsconfig.json benchmarks/seed/reset.ts",
    "metrics:static": "./benchmarks/static/run_static.sh"
  }
}
